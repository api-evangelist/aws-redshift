              "query": [
                {
                  "description": "(Required) <p>The unique identifier of a cluster whose resize progress you are requesting. This parameter is case-sensitive.</p> <p>By default, resize operations for all clusters defined for an Amazon Web Services account are returned.</p>",
                  "key": "ClusterIdentifier",
                  "value": "<string>"
