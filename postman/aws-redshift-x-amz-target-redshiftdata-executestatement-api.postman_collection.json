              "raw": "{\n  \"Database\": \"<string>\",\n  \"Sql\": \"<string>\",\n  \"ClientToken\": \"<string>\",\n  \"ClusterIdentifier\": \"<string>\",\n  \"DbUser\": \"<string>\",\n  \"Parameters\": [\n    {\n      \"name\": \"4hLKJ\",\n      \"value\": \"<string>\"\n    }\n  ],\n  \"SecretArn\": \"<string>\",\n  \"StatementName\": \"<string>\",\n  \"WithEvent\": \"<boolean>\",\n  \"WorkgroupName\": \"arn:aws-rrnknvw-rnlt-ljviqum-hhdnwuomyoi-cakn-z-frtpwko-gmlcl-h-gmmd:redshift-serverless:bh-gov-eic-5:750071748364:workgroup/ea8\"\n}",
