              "raw": "{\n  \"Database\": \"<string>\",\n  \"ClusterIdentifier\": \"<string>\",\n  \"ConnectedDatabase\": \"<string>\",\n  \"DbUser\": \"<string>\",\n  \"MaxResults\": \"<integer>\",\n  \"NextToken\": \"<string>\",\n  \"SchemaPattern\": \"<string>\",\n  \"SecretArn\": \"<string>\",\n  \"TablePattern\": \"<string>\",\n  \"WorkgroupName\": \"fy7gwm9i8\"\n}",
