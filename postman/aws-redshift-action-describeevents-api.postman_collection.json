              "raw": "{{baseUrl}}/?SourceIdentifier=<string>&SourceType=cluster&StartTime=<dateTime>&EndTime=<dateTime>&Duration=<integer>&MaxRecords=<integer>&Marker=<string>&Action=DescribeEvents&Version=2012-12-01#Action=DescribeEvents",
              "host": [
