              "raw": "{\n  \"Database\": \"<string>\",\n  \"ClusterIdentifier\": \"<string>\",\n  \"ConnectedDatabase\": \"<string>\",\n  \"DbUser\": \"<string>\",\n  \"MaxResults\": \"<integer>\",\n  \"NextToken\": \"<string>\",\n  \"Schema\": \"<string>\",\n  \"SecretArn\": \"<string>\",\n  \"Table\": \"<string>\",\n  \"WorkgroupName\": \"dddd\"\n}",
